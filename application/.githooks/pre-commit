#!/bin/sh
# Optional pre-commit hook (NOT enabled automatically). Enable with:  git config core.hooksPath .githooks
# Runs the pattern-based safety scan over tracked and untracked-but-not-ignored files. Blocks the commit on any finding.
cd "$(git rev-parse --show-toplevel)" || exit 2
PYTHONPATH=src python -B -m niftypaper.safety.scan --root . --include-untracked
